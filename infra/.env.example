# Copy sang .env rồi điền giá trị thật. Không commit .env.
DB_PASSWORD=change-me-strong-32chars
REDIS_PASSWORD=change-me-redis-32chars

# Dùng cho backend sau này (NestJS)
DATABASE_URL=postgres://nonglac_user:${DB_PASSWORD}@127.0.0.1:5432/nonglac_db
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379
MQTT_URL=mqtt://127.0.0.1:1883
